// Recall — Prisma schema (SQLite for MVP)
// Mirrors the data model in §6 of the product brief.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  avatarUrl    String?
  authProvider String    @default("email") // "email" | "google"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  settings    Settings?
  notebooks   Notebook[]
  notes       Note[]
  tags        Tag[]
  decks       Deck[]
  reviewLogs  ReviewLog[]
  collaborations Collaborator[]
  comments    Comment[]
  onboarding  Onboarding?
  articles    Article[]
}

model Settings {
  userId             String   @id
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme              String   @default("dark") // "dark" | "light"
  reducedMotion      Boolean  @default(false)
  dailyNewCardLimit  Int      @default(20)
  dailyReviewLimit   Int      @default(200)
  timezone           String   @default("UTC")
  aiProcessingOptOut Boolean  @default(false)
  // Phase 2: due-card reminders
  reminderTime       String?  // "HH:MM" in user's timezone, null = disabled
  reminderEmailEnabled Boolean @default(false)
  reminderEmail      String?  // optional override email
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Notebook {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#34E7A8")
  parentId  String?
  parent    Notebook? @relation("NotebookTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Notebook[] @relation("NotebookTree")
  notes     Note[]
  collaborators Collaborator[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Note {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebookId       String?
  notebook         Notebook? @relation(fields: [notebookId], references: [id], onDelete: SetNull)
  title            String   @default("")
  contentMarkdown  String   @default("")
  contentPlainText String   @default("") // denormalized for FTS
  isArchived       Boolean  @default(false)
  isPinned         Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tags        NoteTag[]
  summaries   Summary[]
  flashcards  Flashcard[]
  attachments Attachment[]
  embeddings  Embedding[]
  comments    Comment[]
  linksFrom   NoteLink[] @relation("LinksFrom")
  linksTo     NoteLink[] @relation("LinksTo")

  @@index([userId])
  @@index([notebookId])
}

// Tier 1: Bidirectional links between notes.
// When note A contains [[B]], a NoteLink row is created with
// fromNoteId=A, toNoteId=B. The backlinks for note B are all
// NoteLink rows where toNoteId=B.
model NoteLink {
  id         String @id @default(cuid())
  fromNoteId String
  toNoteId   String
  fromNote   Note   @relation("LinksFrom", fields: [fromNoteId], references: [id], onDelete: Cascade)
  toNote     Note   @relation("LinksTo", fields: [toNoteId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([fromNoteId, toNoteId])
  @@index([fromNoteId])
  @@index([toNoteId])
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#FFB454")
  notes     NoteTag[]
  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}

model NoteTag {
  noteId String
  tagId  String
  note   Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

model Summary {
  id          String   @id @default(cuid())
  noteId      String
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  summaryText String   @default("")
  modelUsed   String   @default("z-ai-glm")
  status      String   @default("pending") // "pending" | "streaming" | "complete" | "failed"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([noteId])
}

model Deck {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  color       String   @default("#34E7A8")
  sortOrder   Int      @default(0)
  flashcards  Flashcard[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Flashcard {
  id           String   @id @default(cuid())
  deckId       String
  deck         Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  sourceNoteId String?
  sourceNote   Note?    @relation(fields: [sourceNoteId], references: [id], onDelete: SetNull)
  cardType     String   @default("basic") // "basic" | "cloze" | "image-occlusion"
  front        String
  back         String
  imageUrl     String?  // for image-occlusion cards
  occlusions   String?  // JSON: {x, y, w, h, label} for image-occlusion cards
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schedulingState SchedulingState?
  reviewLogs      ReviewLog[]

  @@index([deckId])
}

model SchedulingState {
  cardId            String   @id
  card              Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  dueDate           DateTime @default(now())
  stability         Float    @default(0.4)
  difficulty        Float    @default(0.5)
  interval          Float    @default(0) // in days
  repetitions       Int      @default(0)
  lapses            Int      @default(0)
  algorithmVersion  String   @default("fsrs-4.5")
  lastReviewedAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ReviewLog {
  id              String   @id @default(cuid())
  cardId          String
  card            Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedAt      DateTime @default(now())
  grade           String   // "again" | "hard" | "good" | "easy"
  previousInterval Float   @default(0)
  newInterval     Float    @default(0)
  responseTimeMs  Int      @default(0)
}

model Attachment {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileType  String
  sizeBytes Int      @default(0)
  createdAt DateTime @default(now())

  @@index([noteId])
}

// Phase 2: per-note TF-IDF vector for semantic search + related notes.
// Stored as JSON array of [term, weight] pairs (sparse vector).
// When a true embeddings API is available, swap the vector contents
// without changing the API contract.
model Embedding {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  vector    String   // JSON-serialized sparse TF-IDF vector
  terms     String   // JSON-serialized term list for quick intersection
  algorithm String   @default("tfidf-v1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([noteId])
  @@index([noteId])
}

// Phase 3: Real-time collaboration

model Collaborator {
  id          String   @id @default(cuid())
  notebookId  String
  notebook    Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  userId      String   // the invited user
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("editor") // "editor" | "viewer"
  invitedBy   String   // the user who sent the invite
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([notebookId, userId])
  @@index([notebookId])
  @@index([userId])
}

model Comment {
  id          String   @id @default(cuid())
  noteId      String
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body        String
  anchorText  String?  // optional selected text the comment refers to
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([noteId])
  @@index([userId])
}

// Phase 3: Onboarding personalization

model Onboarding {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completed     Boolean  @default(false)
  studyGoal     String?  // "exam" | "language" | "hobby" | "work" | "school"
  experienceLevel String? // "beginner" | "intermediate" | "advanced"
  interests     String   @default("[]") // JSON array of subject tags
  dailyGoalMinutes Int  @default(15)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Incremental reading — articles broken into sections with highlights
model Article {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  sourceUrl   String?
  rawContent  String   // original pasted text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sections    ArticleSection[]

  @@index([userId])
}

model ArticleSection {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  order       Int      // position in the article
  heading     String
  content     String   // section text
  isRead      Boolean  @default(false)
  highlights  Highlight[]

  @@index([articleId])
}

model Highlight {
  id          String   @id @default(cuid())
  sectionId   String
  section     ArticleSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  userId      String
  text        String   // the highlighted text
  note        String?  // optional user annotation
  cardType    String   @default("cloze") // "cloze" | "basic"
  cardId      String?  // linked Flashcard if converted to a card
  createdAt   DateTime @default(now())

  @@index([sectionId])
  @@index([userId])
}
